include(GNUInstallDirs)
install(TARGETS yolopdf-cli RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
if(YOLOPDF_BUILD_APP)
    install(TARGETS yolopdf RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
    if(WIN32)
        qt_generate_deploy_qml_app_script(TARGET yolopdf OUTPUT_SCRIPT qt_deploy_script NO_UNSUPPORTED_PLATFORM_ERROR)
        install(SCRIPT ${qt_deploy_script})
    elseif(NOT ANDROID)
        install(FILES packaging/linux/org.yolopdf.app.desktop DESTINATION ${CMAKE_INSTALL_DATADIR}/applications)
        install(FILES packaging/linux/org.yolopdf.app.svg DESTINATION ${CMAKE_INSTALL_DATADIR}/icons/hicolor/scalable/apps)
        install(FILES packaging/linux/org.yolopdf.app.metainfo.xml DESTINATION ${CMAKE_INSTALL_DATADIR}/metainfo)
    endif()
endif()
install(FILES LICENSE README.md packaging/licenses/NOTICE.txt DESTINATION ${CMAKE_INSTALL_DATADIR}/yolopdf)
install(DIRECTORY docs/ DESTINATION ${CMAKE_INSTALL_DATADIR}/yolopdf/docs)
install(FILES packaging/licenses/README.md DESTINATION ${CMAKE_INSTALL_DATADIR}/yolopdf/dependency-licenses)
# Preserve notices from the exact enabled MuPDF tree and recursive dependencies.
file(GLOB_RECURSE dependency_notices RELATIVE "${PROJECT_SOURCE_DIR}/third_party/mupdf"
    "${PROJECT_SOURCE_DIR}/third_party/mupdf/*COPYING*" "${PROJECT_SOURCE_DIR}/third_party/mupdf/*LICENSE*" "${PROJECT_SOURCE_DIR}/third_party/mupdf/*NOTICE*")
foreach(notice IN LISTS dependency_notices)
    get_filename_component(folder "${notice}" DIRECTORY)
    install(FILES "${PROJECT_SOURCE_DIR}/third_party/mupdf/${notice}" DESTINATION "${CMAKE_INSTALL_DATADIR}/yolopdf/dependency-licenses/mupdf/${folder}")
endforeach()
if(WIN32 AND YOLOPDF_BUILD_APP)
    set(CPACK_PACKAGE_NAME "yolopdf")
    set(CPACK_PACKAGE_VENDOR "yolopdf")
    set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
    set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Offline PDF editor development preview")
    set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
    set(CPACK_GENERATOR "NSIS")
    set(CPACK_NSIS_DISPLAY_NAME "yolopdf")
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
    set(CPACK_NSIS_EXTRA_INSTALL_COMMANDS "WriteRegStr HKCR 'Applications\\yolopdf.exe\\shell\\open\\command' '' '\"$INSTDIR\\bin\\yolopdf.exe\" \"%1\"'\nWriteRegStr HKCR '.pdf\\OpenWithList\\yolopdf.exe' '' ''")
    set(CPACK_NSIS_EXTRA_UNINSTALL_COMMANDS "DeleteRegKey HKCR 'Applications\\yolopdf.exe'\nDeleteRegKey HKCR '.pdf\\OpenWithList\\yolopdf.exe'")
    include(CPack)
endif()
install(DIRECTORY packaging/licenses/qt/ DESTINATION ${CMAKE_INSTALL_DATADIR}/yolopdf/dependency-licenses/qt)
